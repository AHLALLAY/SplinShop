// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// config
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// enums
enum Role {
  customer
  seller
  admin
}

enum Status {
  active
  suspend
}

enum Stock {
  in_stock
  out_of_stock
  available_on_order
}

// models
model User {
  // --- 1. Identifiant ---
  id String @id @default(uuid())

  // --- 2. Informations principales ---
  name     String
  email    String  @unique
  phone    String? @unique
  password String

  // --- 3. Statuts et booléens ---
  role      Role    @default(customer)
  status    Status  @default(active)
  isDeleted Boolean @default(false)

  // --- 4. Timestamps ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Catalog {
  // --- 1. Identifiant ---
  id String @id @default(uuid())

  // --- 2. Informations principales ---
  name        String  @unique
  slug        String? @unique
  description String?
  imgUrl      String?

  // --- 3. Statuts et booléens ---
  status    Status  @default(active)
  isHidden  Boolean @default(false)
  isDeleted Boolean @default(false)

  // --- 4. Timestamps ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- 5. Relations inverses ---
  subCatalogs SubCatalog[]
}

model SubCatalog {
  // --- 1. Identifiant ---
  id String @id @default(uuid())

  // --- 2. Informations principales ---
  name String

  // --- 3. Relations (Clés étrangères) ---
  catalogId String
  catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: Restrict)

  // --- 4. Timestamps ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- 5. Relations inverses ---
  products Product[]
}

model Product {
  // --- 1. Identifiant ---
  id String @id @default(uuid())

  // --- 2. Informations principales ---
  name        String
  slug        String? @unique
  description String? @db.Text
  price       Decimal @db.Decimal(10, 2)
  quantity    Int     @default(0)

  // --- 3. Statuts et booléens ---
  status      Status  @default(active)
  stockStatus Stock   @default(in_stock)
  isHidden    Boolean @default(false)
  isDeleted   Boolean @default(false)

  // --- 4. Timestamps ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- 5. Relations inverses ---
  images      Image[]
  subCatalogs SubCatalog[]
}

model Image {
  // --- 1. Identifiant ---
  id String @id @default(uuid())

  // --- 2. Informations principales ---
  imgUrl    String
  isPrimary Boolean @default(false)

  // --- 3. Relations (Clés étrangères) ---
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // --- 4. Timestamps ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
